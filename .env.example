# ---- Run mode -----------------------------------------------------------
# sim  : no external calls. Scripted agent brains + simulated marketplace demand.
#        The game runs fully offline. Use this first.
# live : real Claude agents. Anything that touches money/accounts/publishing
#        still stops at the Airlock for your approval.
MODE=sim

# ---- Claude (live mode only) -------------------------------------------
# Leave unset to use `ant auth login` profile credentials.
# ANTHROPIC_API_KEY=
OVERSEER_MODEL=claude-opus-5
WORKER_MODEL=claude-sonnet-5
# Hard daily ceiling on token spend across all agents, in USD cents.
DAILY_TOKEN_BUDGET_CENTS=2000

# ---- Server -------------------------------------------------------------
PORT=8787
DB_PATH=./data/station.sqlite
WORKSPACE_ROOT=./data/workspaces
# Ticks per real second at 1x speed (a tick is one simulated hour).
TICK_HZ=2

# ---- Platform adapters (all optional; missing key => adapter runs in
#      "draft-only" mode and hands you the copy/paste payload in the Airlock)
# PRINTIFY_API_TOKEN=
# PRINTIFY_SHOP_ID=
# ETSY_API_KEY=
# ETSY_ACCESS_TOKEN=
# ETSY_SHOP_ID=
# GUMROAD_ACCESS_TOKEN=
# ITCH_API_KEY=
# WORDPRESS_URL=
# WORDPRESS_USER=
# WORDPRESS_APP_PASSWORD=
