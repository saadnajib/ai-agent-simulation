{
  "name": "eternity-station",
  "private": true,
  "version": "0.1.0",
  "description": "Eternity Station: a space-dungeon venture studio where an Overseer agent allocates capital to crews of AI agents running real (or simulated) micro-businesses.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,station -c cyan,magenta \"pnpm --filter @eternity/server dev\" \"pnpm --filter @eternity/station dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "start": "pnpm --filter @eternity/server start",
    "sim": "MODE=sim pnpm --filter @eternity/server start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
